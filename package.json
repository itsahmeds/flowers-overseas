{
  "name": "flowers-overseas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "pnpm lint:js && pnpm lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:fixtures": "node scripts/lint-fixtures.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:fixtures": "tsc --noEmit -p tsconfig.fixtures.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:contract": "vitest run --project contract --passWithNoTests",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "playwright test --project=e2e-desktop --project=e2e-mobile",
    "test:visual": "playwright test --project=visual --project=pseudo-rtl",
    "test:a11y": "playwright test --project=a11y",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-layout": "node scripts/check-layout.ts",
    "env:check": "node scripts/env-check.ts",
    "db:check": "node scripts/db-check.ts",
    "seed:project": "node seed/project.ts",
    "media:variants": "node seed/media-variants.ts",
    "i18n:check": "node scripts/i18n-check.ts",
    "catalogue:check": "node scripts/catalogue-check.ts",
    "i18n:draft": "node scripts/i18n-draft.ts",
    "i18n:pseudo": "node scripts/i18n-pseudo.ts",
    "fonts:build": "node scripts/fonts/build-fonts.ts",
    "audit": "pnpm audit --prod --audit-level=high && pnpm audit:secrets",
    "audit:secrets": "node scripts/audit-secrets.ts",
    "branch-protection": "node scripts/branch-protection.ts",
    "pr-policy": "node scripts/pr-policy.ts",
    "dev-os:check": "node scripts/dev-os-check.ts",
    "seo:validate": "node scripts/seo/validate-sitemap.ts && node scripts/seo/validate-hreflang.ts && node scripts/seo/validate-schema.ts",
    "lighthouse": "npx --yes @lhci/cli@0.15.1 autorun --config=lighthouserc.json $(node scripts/seo/lighthouse-urls.ts)",
    "budget:client-js": "node scripts/client-js-budget.ts",
    "check:no-literal-disable": "node scripts/check-no-literal-disable.ts",
    "check:no-db": "node scripts/check-no-db-imports.ts",
    "cookies:check": "node scripts/cookie-register.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@next/env": "^16.3.4",
    "@sentry/nextjs": "^10.73.0",
    "next": "16.3.4",
    "next-intl": "4.14.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/lint": "^21.2.2",
    "@commitlint/load": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@formatjs/icu-messageformat-parser": "3.5.17",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/oxide": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "fast-xml-parser": "^5.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "0.35.4",
    "stylelint": "^17.15.0",
    "subset-font": "2.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
