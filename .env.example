# Flowers Overseas — environment contract (spec 001 §5, TASK-005; spec 002 §2, TASK-013;
# spec 040 §5.2, TASK-097 — `APP_ENV` and its browser mirror).
#
# Every key below exists in the zod schemas of `src/lib/env.ts`; `pnpm env:check` fails when the
# two lists differ in either direction (spec 001 AC-11, spec 002 AC-1). Values here are
# syntactically valid dummies (spec 001 §13 Q10) so that `cp .env.example .env.local && pnpm build`
# succeeds on a clean clone. They are **rejected** by the schema in `preview`, `staging` and
# `production` (spec 040 AC-5), where the real values live in the platform env store. Since spec
# 002 (AC-2) there is **no escape hatch**: a deployed environment must carry real values, and a
# placeholder fails the build with the offending key named and no value printed.
#
# Legend per key: purpose · where the real value lives · secret?

# --- Public (NEXT_PUBLIC_*): inlined into the browser bundle, never secret --------------------

# Absolute site origin, used for canonical and absolute URLs · Vercel env store · not secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser mirror of APP_ENV: development|test|preview|staging|production (spec 040 §5.2, AC-3).
# Set it to the same value as APP_ENV in every deployed environment; blank locally, where the
# unset case resolves to `development` · Railway / Vercel env store · not secret
NEXT_PUBLIC_APP_ENV=

# Mirror of VERCEL_ENV. **Unread by application code** since spec 040 (§5.2): it stays in the
# contract only until the Vercel unlink of §13 Q5 · injected by Vercel · not secret · blank
NEXT_PUBLIC_VERCEL_ENV=

# Browser Sentry DSN; blank ⇒ the browser SDK is a no-op · Vercel env store (EU org, §13 Q6) · not secret
NEXT_PUBLIC_SENTRY_DSN=

# GA4 measurement id, `G-XXXXXXXXXX`. **Blank in Phase 0** (CI, local, preview): with no id there is
# no tag element and no request to googletagmanager.com at all. Setting it in the production env
# store turns Google Analytics on with Consent Mode v2 default-denied and is a RoPA-affecting act
# (docs/compliance/ropa.md row 4, docs/runbooks/analytics-consent.md) · Vercel env store · not secret
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Commit SHA readable in the browser; the Sentry release for client events · injected by Vercel
# (System Environment Variables) · not secret · leave blank locally
NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=

# --- Server only: never referenced from a client component ------------------------------------

# Pooled Postgres connection string (Neon, Frankfurt aws-eu-central-1, PgBouncer transaction mode).
# Used by every web request · Neon dashboard → Connection string (pooled) / Vercel env store · SECRET
DATABASE_URL=postgres://user:pass@localhost:5432/fo

# Direct (unpooled) connection string for the same database: migrations, db:check, pg-boss and the
# nightly backup, none of which may run through a transaction-mode pooler · Neon dashboard · SECRET
DATABASE_URL_UNPOOLED=postgres://user:pass@localhost:5432/fo_direct

# Server/edge Sentry DSN; blank ⇒ Sentry is a no-op · Vercel env store (EU org, §13 Q6) · SECRET-ish
SENTRY_DSN=

# Source-map upload token; CI only, never needed locally · GitHub Actions secret · SECRET
SENTRY_AUTH_TOKEN=

# Shared secret for internal cron/job endpoints (unused until the job runner exists) · Vercel env store · SECRET
INTERNAL_CRON_SECRET=placeholder-cron-secret

# Logger threshold: fatal|error|warn|info|debug|trace · Vercel env store · not secret
LOG_LEVEL=info

# --- Cloudflare R2 (EU jurisdiction): media bucket + private backups bucket (ADR-0015) ----------

# Cloudflare account id: 32 hex characters, the prefix of the S3 endpoint below · Cloudflare
# dashboard → R2 → Account details · not secret (but not published either)
R2_ACCOUNT_ID=00000000000000000000000000000000

# Public media bucket: images and their derived variants · Cloudflare R2 · not secret
R2_BUCKET=placeholder-bucket

# Private bucket for the nightly pg_dump artefacts (30-day lifecycle rule, never public) · not secret
R2_BACKUPS_BUCKET=placeholder-backups-bucket

# S3-compatible endpoint of the account · https://<account-id>.eu.r2.cloudflarestorage.com · not secret
R2_S3_ENDPOINT=https://00000000000000000000000000000000.eu.r2.cloudflarestorage.com

# Access key id of the scoped R2 API token (object read/write on both buckets) · Vercel env store · SECRET
R2_ACCESS_KEY_ID=placeholder-r2-access-key-id

# Secret access key of the same token · Vercel env store · SECRET — shown once at token creation
R2_SECRET_ACCESS_KEY=placeholder-r2-secret-access-key

# Public base URL media is served from — since 2026-09-22 the Cloudflare custom domain
# https://media.flowersoverseas.com, no trailing slash · Cloudflare R2 → Settings → Custom domains
# · not secret. The value below is the placeholder a clean clone builds with, not the real host.
# Read by `pnpm media:upload`, which refuses to run unless it equals MEDIA_ORIGIN in
# src/lib/media-origin.ts — the constant the site builds every image URL and its CSP img-src from
# (it has to be a constant: the pages are prerendered in a credential-free container build that
# has no R2_* variable at all). Change both together (TASK-138).
R2_PUBLIC_BASE_URL=https://placeholder.r2.dev

# --- Neon control plane: the daily usage probe only (spec 002 AC-24). All optional ---------------

# Neon API key for the compute/storage usage probe. Blank ⇒ the job logs one info line and succeeds
# · Neon dashboard → API keys · SECRET
NEON_API_KEY=

# Neon project id the probe reads · Neon dashboard · not secret · blank until the probe exists
NEON_PROJECT_ID=

# Neon branch the two connection strings point at (`production`) · documentation for operators
NEON_BRANCH=

# --- The environment signal, and the platform variables behind it ------------------------------

# THE environment signal (spec 040 §5.2, AC-1): development|test|preview|staging|production.
# Set by whichever platform runs the app — Railway variables, the Vercel env store, CI — and read
# by `appEnvironment()` alone. **Blank means `development`, which means `noindex`**: unset is the
# fail-closed default and is correct on a laptop. A value that is present and is not one of the
# five fails the build naming the key, so a typo like `prod` cannot quietly produce a
# `development` build that passes the placeholder guard it was supposed to fail
# · Railway / Vercel env store · not secret
APP_ENV=

# --- Not part of the contract: the two absent-means-off switches (spec 040 §12) -----------------
#
# Deliberately commented out. `pnpm env:check` compares this file with the zod schemas key for
# key, and these two are not schema keys: they are environment-scoped switches whose whole
# semantics is "absent ⇒ off", set on one environment and on no other, and AC-11's declared key
# set is exactly the 28 uncommented keys above. `config/railway.json`'s contract in
# `src/lib/railway.ts` declares where each one is allowed, and `pnpm railway:check --env <name>`
# is what enforces that.
#
# STAGING_BASIC_AUTH=user:password
#   Turns on the 401 wall in `src/proxy.ts` for every non-production environment, `/api/health`
#   exempt (spec 040 AC-25). Set on `staging` and on PR environments, never on `production`.
#   The founder pastes the value into Railway; it is never in this repository. Set it locally
#   only to reproduce the wall: `STAGING_BASIC_AUTH='user:pass' pnpm start`.
#
# CLOUDFLARE_API_TOKEN=…
#   Enables the real cache-purge adapter (spec 040 AC-22, TASK-102). Not read yet.

# --- Injected by the platform: read-through only, blank locally --------------------------------

# development|test|preview|staging|production · injected by Vercel · not secret. Since spec 040
# this is only `appEnvironment()`'s compatibility fallback for the cold Vercel rollback (§13 Q5)
VERCEL_ENV=

# Commit SHA; used as the Sentry release · injected by Vercel · not secret
VERCEL_GIT_COMMIT_SHA=

# Add the en-XA / ar-XB pseudo-locales to the routing table: `true` locally and on previews (where
# the visual and a11y suites run), refused in production **and staging** by the zod schema —
# leave it unset or `false` there (spec 003 §2, §8, §13 Q6; spec 040 AC-5: staging is shown to
# florists) · Railway / Vercel env store (preview scope) · not secret
ENABLE_PSEUDO_LOCALES=true

# Send the Content-Security-Policy as Content-Security-Policy-Report-Only rather than enforcing it
# (ADR-0016, spec 004 §5.2, AC-23). Absent or anything other than the exact string "false" means
# report-only; set it to "false" per environment once the /api/csp-report evidence is empty
# · Vercel env store · not secret
CSP_REPORT_ONLY=true

# Serve the component gallery at /dev/components: `true` locally and on previews (the visual and
# axe surface for every component state), refused in production **and staging** by the zod schema
# — leave it unset or `false` there (spec 004 §2, §12, AC-28; spec 040 AC-5) · Railway / Vercel
# env store (preview scope) · not secret
ENABLE_DEV_UI=true
