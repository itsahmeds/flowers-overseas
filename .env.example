# Flowers Overseas — environment contract (spec 001 §5, TASK-005).
#
# Every key below exists in the zod schemas of `src/lib/env.ts`; `pnpm env:check` fails when the
# two lists differ in either direction (AC-11). Values here are syntactically valid dummies
# (spec 001 §13 Q10) so that `cp .env.example .env.local && pnpm build` succeeds on a clean clone
# (AC-1). They are rejected by the schema in `preview` and `production`, where the real values
# live in the Vercel env store.
#
# Legend per key: purpose · where the real value lives · secret?

# --- Public (NEXT_PUBLIC_*): inlined into the browser bundle, never secret --------------------

# Absolute site origin, used for canonical and absolute URLs · Vercel env store · not secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL · Vercel env store (real project arrives with spec 002) · not secret
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co

# Supabase anon key; RLS-protected, safe in the browser · Vercel env store · not secret
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# Mirror of VERCEL_ENV for client code · injected by Vercel · not secret · leave blank locally
NEXT_PUBLIC_VERCEL_ENV=

# Browser Sentry DSN; blank ⇒ the browser SDK is a no-op · Vercel env store (EU org, §13 Q6) · not secret
NEXT_PUBLIC_SENTRY_DSN=

# Commit SHA readable in the browser; the Sentry release for client events · injected by Vercel
# (System Environment Variables) · not secret · leave blank locally
NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=

# --- Server only: never referenced from a client component ------------------------------------

# Postgres connection string · Vercel env store / Supabase dashboard · SECRET
DATABASE_URL=postgres://user:pass@localhost:5432/fo

# Supabase service-role key; bypasses RLS · Vercel env store · SECRET
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# Server/edge Sentry DSN; blank ⇒ Sentry is a no-op · Vercel env store (EU org, §13 Q6) · SECRET-ish
SENTRY_DSN=

# Source-map upload token; CI only, never needed locally · GitHub Actions secret · SECRET
SENTRY_AUTH_TOKEN=

# Shared secret for internal cron/job endpoints (unused until the job runner exists) · Vercel env store · SECRET
INTERNAL_CRON_SECRET=placeholder-cron-secret

# Logger threshold: fatal|error|warn|info|debug|trace · Vercel env store · not secret
LOG_LEVEL=info

# --- Injected by the platform: read-through only, blank locally --------------------------------

# development|test|preview|production · injected by Vercel · not secret
VERCEL_ENV=

# Commit SHA; used as the Sentry release · injected by Vercel · not secret
VERCEL_GIT_COMMIT_SHA=

# Accept the placeholder values above in preview/production. Only "true" is accepted; blank
# locally. 001 only; set in Vercel production; spec 002 removes it · Vercel env store · not secret
ALLOW_PLACEHOLDER_ENV=

# Add the en-XA / ar-XB pseudo-locales to the routing table: `true` locally and on previews (where
# the visual and a11y suites run), refused in production by the zod schema — leave it unset or
# `false` there (spec 003 §2, §8, §13 Q6) · Vercel env store (preview scope) · not secret
ENABLE_PSEUDO_LOCALES=true
