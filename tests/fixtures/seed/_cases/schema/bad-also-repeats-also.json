{
  "family": "schema",
  "rule": "schema",
  "replaces": "occasion-country.json",
  "expect": "repeats another `also` date",
  "why": "AC-75: two equal `also` dates would print the same day twice in the hub's cell.",
  "ops": [
    {
      "op": "setRow",
      "match": {
        "occasionKey": "grandparents_day",
        "countryIso2": "PL"
      },
      "set": {
        "rule": {
          "kind": "fixed",
          "month": 1,
          "day": 21,
          "also": [
            {
              "month": 1,
              "day": 22
            },
            {
              "month": 1,
              "day": 22
            }
          ]
        }
      }
    }
  ]
}
