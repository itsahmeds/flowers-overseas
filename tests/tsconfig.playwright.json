{
  // Module resolution for the Playwright loader only (TASK-008). Playwright type-checks and runs
  // the specs on Node rather than through the Next.js bundler, so the `@/*` alias has to be
  // restated here; `pnpm typecheck` and ESLint use the root `tsconfig.json`.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["../src/*"]
    }
  }
}
